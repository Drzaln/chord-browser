<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Downloads are written straight to ~/Downloads without a save panel
	     (M4). WKDownloadDelegate must hand back a writable destination, and
	     user-selected access alone cannot reach that folder unprogrammed. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Printing (M6). A sandboxed app cannot open the print system without
	     this; without it WKWebView's print operation is refused and AppKit
	     puts up "This application does not support printing." swift test runs
	     unsandboxed and cannot catch that — verified against the real app. -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- Camera and microphone for getUserMedia (Google Meet, Slack huddles).
	     A sandboxed app cannot open a capture device without these; WebKit's
	     media-capture permission grant is refused by the OS otherwise. The
	     first use still shows the system TCC prompt (see NSCamera/Microphone
	     UsageDescription in Info.plist). swift test runs unsandboxed and cannot
	     catch this — verify against the real app. Screen sharing is not
	     included: public WKWebView exposes no display-capture hook. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
	<!-- Hardened Runtime (Release) uses a DIFFERENT key for the microphone than
	     App Sandbox does: `device.audio-input`, not `device.microphone`. Camera
	     shares one key (`device.camera`) across both, which is why camera worked
	     in Release while the mic did not. Debug disables Hardened Runtime (ad-hoc
	     signing), so the sandbox key alone sufficed there and hid the gap. Both
	     mic keys are declared so the microphone works under sandbox and hardened
	     runtime alike. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
