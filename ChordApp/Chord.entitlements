<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Chord ships unsandboxed. It is distributed direct/notarized (Developer ID),
	     not through the Mac App Store, which requires sandboxing — and an
	     unsandboxed browser can spawn native-messaging hosts (third-party
	     integrations) and write anywhere, neither of which the sandbox permits.
	     This is the same trade Chrome/Firefox/Edge make.

	     No com.apple.security.app-sandbox key: the app itself is unsandboxed.

	     The device.camera / device.microphone / device.audio-input keys below do
	     NOT re-sandbox the app. They are required so WebKit's WebContent child
	     process (which runs in its own sandbox regardless) is permitted to open
	     the camera/mic devices — WebKit derives the child's sandbox profile from
	     these host-app entitlements, and without them getUserMedia fails with a
	     permission error before TCC is ever consulted. The OS TCC prompt (backed
	     by the NS*UsageDescription strings in Info.plist) still gates the user's
	     first-time consent.

	     com.apple.security.personal-information.location plays the same role for
	     navigator.geolocation: unsandboxed, it does not restrict the app, but it
	     tells WebKit to let the WebContent child reach CoreLocation. The TCC gate
	     is NSLocationWhenInUseUsageDescription in Info.plist.

	     On-disk data moves from the sandbox container to the real
	     ~/Library/Application Support — see AppEnvironment.live(), which migrates
	     it on first launch. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>