          "stringUnit": {
            "state": "translated",
            "value": "Perkecil"
          }
        }
      }
    },
    "Zoom a page with ⌘= and ⌘-, and return to actual size with ⌘0. These are menu commands, not a setting.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom halaman dengan ⌘= dan ⌘-, dan kembali ke ukuran sebenarnya dengan ⌘0. Ini perintah menu, bukan pengaturan."
          }
        }
      }
    },
