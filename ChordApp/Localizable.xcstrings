      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan agen mengeklik “%@”?"
          }
        }
      }
    },
    "Allow an agent to run JavaScript on %@?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan agen menjalankan JavaScript di %@?"
          }
        }
      }
    },
    "Allow an agent to submit a form?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan agen mengirim formulir?"
          }
        }
      }
