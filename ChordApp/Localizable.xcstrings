    "Not found": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan"
          }
        }
      }
    },
    "Nothing here is written to disk — no history, no saved tabs, no cookies. Close the window and the session is gone.\nIt does not hide you from the sites you visit or from your network. Downloads and passwords you fill are real.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang ditulis ke disk di sini — tanpa riwayat, tanpa tab tersimpan, tanpa cookie. Tutup jendela dan sesinya hilang.\nIni tidak menyembunyikan Anda dari situs yang dikunjungi atau dari jaringan Anda. Unduhan dan kata sandi yang Anda isi tetap nyata."
          }
        }
      }
    },
    "Nothing new to import": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang baru untuk diimpor"
          }
