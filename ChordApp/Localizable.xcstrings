    "Unpin": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepas Sematan"
          }
        }
      }
    },
    "Unpin from Address Bar": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepas Sematan dari Bilah Alamat"
          }
        }
      }
    },
    "Unpinned tabs you haven't touched for this long are moved to the archive, reachable from the command bar. Pinned tabs and tabs playing audio are never archived.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab tidak disematkan yang tidak Anda sentuh selama ini dipindahkan ke arsip, dapat dijangkau dari bilah perintah. Tab yang disematkan dan tab yang memutar audio tidak pernah diarsipkan."
          }
        }
      }
    },
    "Unpinned, it still runs; open it from the … button in the address bar.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa disematkan, ekstensi tetap berjalan; buka dari tombol … di bilah alamat."
          }
        }
      }
    },
    "Unsaved changes": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan belum disimpan"
          }
        }
      }
    },
    "Unverified extension": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstensi belum terverifikasi"
          }
        }
      }
    },
    "Update": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbarui"
          }
        }
      }
    },
    "Update installed. Restart to finish.": {
