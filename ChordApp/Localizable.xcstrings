    "Allow on %@ Until Quit": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan di %@ Sampai Keluar"
          }
        }
      }
    },
    "Already saved in Chord: %lld. Existing passwords are never overwritten.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah tersimpan di Chord: %lld. Kata sandi yang ada tidak pernah ditimpa."
          }
        }
      }
    },
    "Also route ⌘-clicked and target=_blank links": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan juga tautan yang diklik dengan ⌘ dan target=_blank"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan"
          }
        }
      }
    },
    "Arc Import": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor Arc"
          }
        }
      }
    },
    "Arc's sidebar is larger than the import limit; later items are left behind.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah sisi Arc melebihi batas impor; item selanjutnya ditinggalkan."
          }
        }
      }
    },
    "Arc's sidebar is too large": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah sisi Arc terlalu besar"
          }
        }
      }
    },
    "Archive Inactive Tabs": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arsipkan Tab Tidak Aktif"
          }
        }
      }
    },
    "Ask Again": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanya Lagi"
          }
        }
      }
    },
    "Authentication was cancelled.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi dibatalkan."
          }
        }
      }
    },
    "Background Tabs": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab Latar Belakang"
          }
        }
      }
    },
    "Background worker (on demand)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pekerja latar belakang (sesuai kebutuhan)"
          }
        }
      }
    },
    "Bookmarks": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Markah"
          }
        }
      }
    },
    "Bookmarks imported: %lld": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Markah diimpor: %lld"
          }
        }
      }
    },
    "Bring your things across": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa data Anda ke sini"
          }
        }
      }
    },
    "Camera, microphone, location, and notification choices you have made, per Space. Removing one asks again next time.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan kamera, mikrofon, lokasi, dan notifikasi yang Anda buat, per Space. Menghapus salah satu membuat Chord bertanya lagi lain kali."
          }
        }
      }
    },
    "Camera, microphone, location, and notification choices, per Space.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan kamera, mikrofon, lokasi, dan notifikasi, per Space."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batal"
          }
        }
      }
    },
    "Cancel Sleep Timer": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan Pengatur Waktu Tidur"
          }
        }
      }
    },
    "Cancel download": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan unduhan"
          }
        }
      }
    },
    "Cancel sleep timer": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan pengatur waktu tidur"
          }
        }
      }
    },
    "Cancelled": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibatalkan"
          }
        }
      }
    },
    "Change how a site looks: your own CSS, a script, or elements hidden for good. Covers the domain and its subdomains. Changes apply the next time the page loads — reload the tab to see them.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah tampilan situs: CSS Anda sendiri, skrip, atau elemen yang disembunyikan seterusnya. Berlaku untuk domain dan subdomainnya. Perubahan berlaku saat halaman dimuat berikutnya — muat ulang tab untuk melihatnya."
          }
        }
      }
    },
    "Check GitHub for a new version, then download, install, and restart.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa versi baru di GitHub, lalu unduh, pasang, dan mulai ulang."
          }
        }
      }
    },
    "Check for Updates": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa Pembaruan"
          }
        }
      }
    },
    "Checking for updates…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa pembaruan…"
          }
        }
      }
    },
    "Choose Arc's data folder, or its StorableSidebar.json.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder data Arc, atau berkas StorableSidebar.json miliknya."
          }
        }
      }
    },
    "Choose Emoji…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Emoji…"
          }
        }
      }
    },
    "Choose a Chromium browser's “Login Data” file inside a profile folder — for example Google/Chrome/Default/Login Data.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berkas “Login Data” peramban Chromium di dalam folder profil — misalnya Google/Chrome/Default/Login Data."
          }
        }
      }
    },
    "Choose a bookmarks HTML file exported by another browser.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berkas HTML markah yang diekspor dari peramban lain."
          }
        }
      }
    },
    "Choose a file named “Login Data” inside a Chromium browser's profile folder, for example Google/Chrome/Default/Login Data. Nothing was imported.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berkas bernama “Login Data” di dalam folder profil peramban Chromium, misalnya Google/Chrome/Default/Login Data. Tidak ada yang diimpor."
          }
        }
      }
    },
    "Choose an emoji": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih emoji"
          }
        }
      }
    },
    "Chord can’t connect to %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord tidak dapat terhubung ke %@"
          }
        }
      }
    },
    "Chord can’t find %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord tidak dapat menemukan %@"
          }
        }
      }
    },
    "Chord can’t open this page": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord tidak dapat membuka halaman ini"
          }
        }
      }
    },
    "Chord checks the GitHub releases page (Drzaln/chord-browser) and updates itself by replacing the copy in Applications. You initiate every step — nothing downloads without a click.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord memeriksa halaman rilis GitHub (Drzaln/chord-browser) dan memperbarui dirinya dengan mengganti salinan di Aplikasi. Setiap langkah Anda yang memulai — tidak ada yang diunduh tanpa klik."
          }
        }
      }
    },
    "Chord could not find any folders or http(s) bookmarks in that file.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord tidak menemukan folder atau markah http(s) di berkas itu."
          }
        }
      }
    },
    "Chord could not make a private copy of the database. Nothing was imported.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord tidak dapat membuat salinan privat basis data. Tidak ada yang diimpor."
          }
        }
      }
    },
    "Chord could not make a secure connection to %@, or could not confirm that the site is really %@. Nothing was sent.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord tidak dapat membuat koneksi aman ke %@, atau tidak dapat memastikan bahwa situs itu benar-benar %@. Tidak ada yang dikirim."
          }
        }
      }
    },
    "Chord does not offer to save passwords on these sites.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord tidak menawarkan untuk menyimpan kata sandi di situs-situs ini."
          }
        }
      }
    },
    "Chord follows your Mac's light or dark appearance. Change it in System Settings › Appearance.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
