    "Updates": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan"
          }
        }
      }
    },
    "Use the File menu: Import Bookmarks… (an HTML export), Import from Arc…, and Import Passwords… (Chrome, Brave, Edge and other Chromium browsers).": {
      "localizations": {
